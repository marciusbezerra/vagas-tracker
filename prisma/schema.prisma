generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Jobs {
  id          Int      @id @default(autoincrement())
  vagaIdLinkedIn String   @unique
  company     String
  title       String
  location    String
  type        String
  seniority   String
  status      JobStatus @default(NEW)
  url         String   @unique
  jobDate     DateTime
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum JobStatus {
  NEW
  DISCARDED
  APPLIED
  REJECTED
  INTERVIEWING
  IN_CONTACT
  SEE_LATER
}

model Links {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}